# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Zkopírujte tento soubor jako `.env` a doplňte hodnoty. Soubor `.env` se nikdy necommituje.

# PostgreSQL connection string.
# The default matches docker-compose.yml (user/password/database "terrys" on localhost:5432).
DATABASE_URL=postgres://terrys:terrys@127.0.0.1:5432/terrys

# Optional: host port for the Postgres container from docker-compose.yml (default 5432).
# Change it only if port 5432 is already used by something else on your computer,
# and then use the same port in DATABASE_URL above (e.g. 5433).
POSTGRES_PORT=5432

# Secret used by Payload to sign login tokens and encrypt data.
# Use a long random string (at least 32 characters), different for every environment.
# Generate one e.g. with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of the site, without a trailing slash.
# Locally http://localhost:3000, in production e.g. https://www.terrys.cz
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional, only for `pnpm seed` on a fresh local database: when both are set and the database
# has no users yet, the seed creates an administrator with these credentials.
# Leave empty to create the first user in the browser at /admin instead. Never use in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: `pnpm seed` refuses to run when NODE_ENV=production unless SEED_FORCE=1.
# SEED_FORCE=1

# Optional, stage 8 migration: database that `pnpm migrate:import` writes into.
# Keep it separate from DATABASE_URL (the dev database), create it once and apply migrations:
#   docker exec terrys-postgres-1 psql -U terrys -d postgres -c "CREATE DATABASE terrys_migration"
#   DATABASE_URL=<this url> pnpm payload migrate
# When empty, the import writes into DATABASE_URL.
# MIGRATION_DATABASE_URL=postgres://terrys:terrys@127.0.0.1:5432/terrys_migration
# ---------------------------------------------------------------------------------------------
# Stage 4: orders, e-mails, address check, bot protection. Everything below is OPTIONAL: without
# it orders work, e-mails are only saved to a local folder and nothing external is called.
# ---------------------------------------------------------------------------------------------

# E-mails through Resend (https://resend.com). Without a key NOTHING is sent: every e-mail is
# written to EMAIL_OUTBOX_DIR as .html/.txt/.json and the order shows "Neodesláno" in the admin.
# RESEND_API_KEY=re_...
# Sender; the domain must be verified in Resend (SPF/DKIM DNS records).
# EMAIL_FROM_ADDRESS=objednavky@terrys.cz
# EMAIL_FROM_NAME=Terrys Steak
# Reply-To of the customer confirmation (default: contact e-mail from Nastavení obchodu).
# EMAIL_REPLY_TO=objednavky@terrys.cz
# Staging only: send EVERY e-mail to this one address instead of the real recipient.
# EMAIL_OVERRIDE_TO=test@example.com
# Folder for e-mails when RESEND_API_KEY is empty (default .emails, git-ignored).
# EMAIL_OUTBOX_DIR=.emails

# Who gets the internal copy of every order. Used when "Nastavení obchodu → Objednávky → Kam
# posílat kopii" is empty; when both are empty the contact e-mail is used.
# ORDER_NOTIFICATION_EMAIL=objednavky@terrys.cz

# Foxentry address validation (server-side API, the key never reaches the browser).
# Foxentry admin → project with the "location" service → API key. Empty = no address check.
# FOXENTRY_API_KEY=
# Optional Api-Version header (default 2.0).
# FOXENTRY_API_VERSION=2.0

# Cloudflare Turnstile (bot check on the checkout and withdrawal forms). Both keys or nothing;
# without them the honeypot, timing trap and rate limit still protect the forms.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Only for local load tests: switches off the per-IP rate limit of the checkout endpoints.
# Never set it in production.
# RATE_LIMIT_DISABLED=1
